# MongoDB Connection (Choose Option A: Standard Atlas URI OR Option B: Atlas Data API)
# Option A: MongoDB Atlas / Local URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=smart_attendance

# Option B: MongoDB Atlas Data API (Optional HTTP API alternative)
# MONGODB_DATA_API_URL=mongodb+srv://sriyanshmgr:<db_password>@cluster0.nsvuu2y.mongodb.net/
# MONGODB_DATA_API_KEY=your_atlas_data_api_key
# MONGODB_DATA_SOURCE=Cluster0

# Organization Settings (general | office | school | event)
ORG_NAME=Smart Attendance Hub
DEFAULT_ORG_MODE=general

# ESP32 Hardware Secret Key
DEVICE_SECRET_KEY=esp32_classroom_key_98765
OTP_LIFETIME_SECONDS=30

# Face Recognition Thresholds
FACE_SIMILARITY_THRESHOLD=0.45
MIN_FACE_DETECTION_CONFIDENCE=0.60
BLUR_THRESHOLD=40.0

# Server
HOST=0.0.0.0
PORT=8000
